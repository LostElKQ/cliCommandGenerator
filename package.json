{
  "name": "clicommandgenerator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "build": "vite build",
    "build-storybook": "storybook build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vite dev",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright install && playwright test",
    "test:unit": "vitest"
  },
  "dependencies": {
    "@lucide/svelte": "^1.59.0",
    "@skeletonlabs/skeleton": "^5.0.1",
    "@skeletonlabs/skeleton-svelte": "^5.0.1",
    "lz-string": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.29.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/sveltekit": "^10.6.2",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lz-string": "^1.5.0",
    "@types/node": "^26.6.5",
    "@vite-pwa/sveltekit": "^1.1.0",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.2",
    "eslint-plugin-svelte": "^3.23.1",
    "eslint-plugin-unicorn": "^78.0.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vitest-browser-svelte": "^3.1.0"
  }
}
